[gd_resource type="Resource" script_class="ComboRule" format=3]

[ext_resource type="Script" path="res://scripts/systems/combo_rule.gd" id="1_combo_rule"]

[resource]
script = ExtResource("1_combo_rule")
rule_id = "lightning_x_wet"
display_name = "Wet Conduction"
description = "Lightning shocks wet targets and briefly stuns them."
incoming_tags = Array[String](["lightning"])
target_tags = Array[String](["wet"])
priority = 80
reaction_id = "wet_conduction"
reaction_name = "Wet Conduction"
feedback_text = "{target} conducts the lightning and is stunned."
output_status = "stunned"
output_status_duration = 2.0
output_status_strength = 1.0
output_status_source = "wet_conduction"
output_tags = Array[String](["lightning", "wet", "stunned", "reaction"])
debug_tags = Array[String](["elemental", "status_combo", "lightning"])
design_notes = "Water makes lightning control stronger. Later this can extend to conductive metal, wires, machines, and soaked floors."
