[resource]
script = ExtResource("2_definition")
display_name = "Flash"
description = "Become a lightning bolt and cross the aimed line instantly, stopping at the first solid contact. Flash does not seek a safe landing."
element = "lightning"
category = 1
mana_cost = 4
trait_profile = ExtResource("3_profile")
spell_id = "flash"
short_label = "Flash"
icon_text = "↯"
roles = Array[String](["movement", "traversal", "evasion", "repositioning", "gap_close", "collision_stop", "vertical_mobility"])
targeting_style = "directional_3d"
delivery_type = "instant_travel"
combo_tags = Array[String](["lightning", "flash", "instant", "line_travel", "contact", "momentum"])
status_tags = Array[String]([])
ui_tags = Array[String](["movement", "instant", "aimed", "unsafe_landing"])
debug_tags = Array[String](["prototype", "capsule_profile_sweep", "single_multimesh", "non_damaging"])
scaling_stats = Array[String](["arcana", "lightning", "focus"])
scaling_note = "Lightning and Arcana govern transformation strength; Focus is reserved for future distance, contact, and steering upgrades."
design_notes = "Flash is a full three-dimensional line traversal spell. It moves Grace instantly toward the camera aim until the first solid collision or the prototype distance cap. It performs no ground snap and no safe-destination search, so upward casts deliberately leave Grace airborne. The base spell deals no damage and preserves ongoing states such as Surf."
ability_scene = ExtResource("1_scene")
