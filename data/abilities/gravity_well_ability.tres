[resource]
script = ExtResource("2_definition")
display_name = "Gravity Well"
description = "Collapse local space into a temporary gravity pocket. Nearby creatures and movable objects spiral inward without taking direct damage, bunching the battlefield for follow-up attacks and physics interactions."
element = "space"
category = 4
mana_cost = 2
stamina_cost = 0
focus_cost = 0
use_trait_profile = false
spell_id = "gravity_well"
short_label = "Gravity"
icon_text = "GW"
roles = Array[String](["control", "terrain", "field", "physics", "crowd_control", "setup", "utility"])
targeting_style = "ground_forward"
delivery_type = "spatial_force_field"
combo_tags = Array[String](["space", "gravity", "pull", "cluster", "physics", "field", "setup"])
status_tags = Array[String]([])
ui_tags = Array[String](["control", "field", "physics", "crowd_control"])
debug_tags = Array[String](["matrix_spell", "gravity_field", "continuous_force", "non_damage", "orbit_pull"])
scaling_stats = Array[String](["space", "power", "arcana"])
scaling_note = "Space and Power govern pull force; Arcana is reserved for duration, radius, and orbital-control upgrades."
design_notes = "Gravity Well is a persistent force-control spell. It uses ForceReceiver continuous forces when available, applies native forces to rigid bodies, and has conservative CharacterBody and receive_gravity_pull fallbacks. The caster is excluded by default and all continuous force sources are explicitly cleared when targets leave or the well expires."
