scaling_note = "Future upgrades can increase duration, perceived salience, placement range, behavior complexity, and the number of simultaneous phantoms."
design_notes = "Illusion separates perceived presence from physical presence and combat authority. Recasting replaces the caster's existing phantom. Repeat reenacts placement later; Duplicate creates an independent simultaneous phantom from Soul Grace."
