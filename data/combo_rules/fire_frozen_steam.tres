[resource]
script = ExtResource("1_combo_rule")
rule_id = "fire_x_frozen"
display_name = "Steam Burst"
description = "Fire flashes frozen targets into a cloud of steam, clearing the ice lock and throwing nearby actors off balance."
incoming_tags = Array[String](["fire"])
target_tags = Array[String](["frozen"])
priority = 100
reaction_id = "steam_burst"
reaction_name = "Steam Burst"
feedback_text = "{target} erupts into a steam burst."
visual_style = "steam"
visual_color = Color(0.84, 0.9, 0.96, 1)
visual_radius = 2.4
visual_duration = 0.72
target_reaction_method = "trigger_steam"
output_status = "steamed"
output_status_duration = 2.4
output_status_source = "steam_burst"
remove_statuses = Array[String](["frozen", "burning", "chill"])
output_tags = Array[String](["fire", "ice", "steam", "reaction"])
area_effect_radius = 2.65
area_output_status = "steamed"
area_output_status_duration = 1.8
area_output_status_strength = 1.0
area_output_status_source = "steam_burst"
area_output_stance_damage = 1
area_output_element = "steam"
area_output_tags = Array[String](["fire", "ice", "steam", "reaction", "area"])
area_force_strength = 1.5
area_force_up_strength = 0.35
area_show_status_feedback = true
debug_tags = Array[String](["elemental", "status_combo", "steam", "area_reaction"])
design_notes = "Completes the Water -> Ice -> Fire chain. The primary frozen surface becomes a lingering steam state while a reusable radial area effect steams, nudges, and applies light stance pressure to nearby actors."
