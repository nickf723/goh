[resource]
script = ExtResource("2_definition")
display_name = "Radioactive Rod"
description = "Conjure a radioactive source that irradiates the surrounding area. Exposure accumulates the longer a target remains nearby, causing progressively stronger radiation damage."
element = "poison"
category = 4
mana_cost = 4
stamina_cost = 0
focus_cost = 0
