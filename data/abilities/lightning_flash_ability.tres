[ext_resource type="PackedScene" path="res://scenes/actions/lightning_flash.tscn" id="1_scene"]
[ext_resource type="Script" path="res://scripts/abilities/ability_definition.gd" id="2_definition"]
[ext_resource type="Resource" path="res://data/ability_trait_profiles/movement_utility_profile.tres" id="3_profile"]

[resource]
script = ExtResource("2_definition")
display_name = "Flash"
description = "Hold Cast to move an independent aim pointer, then release to become a lightning bolt and cross that line instantly until first solid contact. Flash does not seek a safe landing."
element = "lightning"
category = 1
mana_cost = 4
trait_profile = ExtResource("3_profile")
spell_id = "flash"
short_label = "Flash"
icon_text = "↯"
roles = Array[String](["movement", "traversal", "evasion", "repositioning", "gap_close", "collision_stop", "vertical_mobility"])
targeting_style = "directional_3d"
delivery_type = "instant_travel"
combo_tags = Array[String](["lightning", "flash", "instant", "line_travel", "contact", "momentum"])
status_tags = Array[String]([])
ui_tags = Array[String](["movement", "instant", "aimed", "unsafe_landing", "hold_to_aim", "free_pointer"])
debug_tags = Array[String](["prototype", "capsule_profile_sweep", "single_multimesh", "non_damaging", "pointer_aim"])
scaling_stats = Array[String](["arcana", "lightning", "focus"])
scaling_note = "Lightning and Arcana govern transformation strength; Focus is reserved for future distance, contact, and pointer-handling upgrades."
design_notes = "Flash is a full three-dimensional line traversal spell. Pressing Cast enters a pointer-aim state without spending Mana; releasing commits the direction, pays the cost, and moves Grace instantly until first solid collision or the prototype distance cap. The pointer may travel beyond the visible viewport edge, so upward and downward aim are no longer limited by camera pitch. Flash performs no ground snap or safe-destination search, and the base spell deals no damage while preserving ongoing states such as Surf."
ability_scene = ExtResource("1_scene")
metadata/_custom_type_script = "res://scripts/abilities/ability_definition.gd"
