[resource]
script = ExtResource("2_definition")
display_name = "Mycelium Mesh"
description = "Grow a rapidly spreading network of mushrooms and mycelial strands that lightly impedes enemies and gives nearby terrain, plants, and mechanisms a shared Life-growth field to react to."
element = "life"
category = 4
mana_cost = 3
stamina_cost = 0
focus_cost = 0
use_trait_profile = false
spell_id = "mycelium_mesh"
