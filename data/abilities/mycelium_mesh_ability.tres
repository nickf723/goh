roles = Array[String](["control", "terrain", "field", "growth", "setup", "utility", "environmental", "network"])
targeting_style = "ground_forward"
delivery_type = "spatial_field"
combo_tags = Array[String](["life", "plant", "fungus", "mycelium", "growth", "terrain", "field_state", "network", "ecology_setup"])
status_tags = Array[String]([])
ui_tags = Array[String](["field_state", "terrain", "control", "non_damage"])
