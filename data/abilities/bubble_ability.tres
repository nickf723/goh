[resource]
script = ExtResource("3_definition")
display_name = "Bubble"
description = "Wrap Grace in a water ward that negates one incoming hit. The Bubble then bursts, knocking nearby enemies, mobs, and loose objects away without dealing damage."
element = "water"
category = 4
mana_cost = 3
