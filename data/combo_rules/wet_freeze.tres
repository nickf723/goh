output_status_source = "wet_freeze"
remove_statuses = Array[String](["wet", "chill"])
output_tags = Array[String](["ice", "wet", "frozen", "reaction"])
debug_tags = Array[String](["elemental", "status_combo", "ice"])
design_notes = "Water sets up hard ice control. Freeze owns the cold-resolution slot and consumes any direct Chill carried by the incoming spell."
