[resource]
script = ExtResource("3_definition")
display_name = "Metal Needle"
description = "Fire nine needles in a rapid fan. The spread covers a crowd at range and concentrates several punctures into a close target."
element = "metal"
category = 4
mana_cost = 2
use_trait_profile = false
spell_id = "metal_needle"
short_label = "Needles"
icon_text = ">>"
roles = Array[String](["damage", "fan", "multishot", "crowd_control", "close_pressure", "projectile"])
targeting_style = "aimed"
delivery_type = "projectile_fan"
combo_tags = Array[String](["metal", "pierce", "sharp", "projectile", "fan", "volley", "multihit"])
status_tags = Array[String]([])
ui_tags = Array[String](["rapid_burst", "wide_fan", "close_multihit", "nine_needles"])
debug_tags = Array[String](["single_controller", "one_multimesh", "no_per_needle_nodes", "target_hit_cap"])
scaling_stats = Array[String](["arcana", "metal", "focus"])
scaling_note = "Metal and Arcana govern puncture pressure; Focus is reserved for future fan width, needle count, ricochet, and homing upgrades."
design_notes = "Metal Needle is one rapid fan volley rather than a generic projectile. One controller advances nine independent collision rays and renders all needles through one MultiMesh. A target can receive at most three needles from one cast, preserving close-range reward without allowing a point-blank nine-hit deletion."
ability_scene = ExtResource("1_scene")
action_payload = ExtResource("2_payload")
metadata/_custom_type_script = "res://scripts/abilities/ability_definition.gd"
