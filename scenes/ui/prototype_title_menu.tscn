[connection signal="pressed" from="Center/MainPanel/Content/NewTrialButton" to="." method="start_new_trial"]
[connection signal="pressed" from="Center/MainPanel/Content/ContinueButton" to="." method="continue_trial"]
[connection signal="pressed" from="Center/MainPanel/Content/ControlsButton" to="." method="show_controls"]
[connection signal="pressed" from="Center/MainPanel/Content/QuitButton" to="." method="quit_game"]
[connection signal="pressed" from="ControlsPanel/Center/Panel/Content/CloseControlsButton" to="." method="hide_controls"]
