scaling_stats = Array[String](["arcana", "poison", "power"])
scaling_note = "Poison and Power are reserved for radiation dose/damage; Arcana can extend field duration and radius."
design_notes = "Matrix contract: Burst / Spatial / Field State. Radioactive Rod is intentionally differentiated from Poison Bloom, Poison Puddle, and Contagion Cloud by cumulative exposure. Brief contact is mild; remaining in the field ramps the dose and damage. Authored targets can react through receive_radiation_exposure without introducing a hard dependency on one status-effect implementation."
