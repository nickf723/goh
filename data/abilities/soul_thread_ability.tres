[resource]
script = ExtResource("3_definition")
display_name = "Soul Thread"
description = "Fire a Soul dart that binds Grace to one actor with a persistent visible thread. The link has slack, builds tension as the target retreats, softly pulls movable targets back toward Grace, and snaps if stretched too far. Recasting refreshes the same link."
element = "soul"
mana_cost = 1
trait_profile = ExtResource("4_profile")
spell_id = "soul_thread"
short_label = "Thread"
icon_text = "S"
roles = Array[String](["control", "utility", "tether", "persistent_link", "spirit"])
targeting_style = "aimed"
delivery_type = "projectile_actor_link"
combo_tags = Array[String](["soul", "spirit", "thread", "link", "tether", "setup"])
status_tags = Array[String]([])
ui_tags = Array[String](["control", "persistent", "single_target", "setup"])
debug_tags = Array[String](["matrix_spell", "persistent_actor_link", "refresh_on_recast", "soft_leash", "boss_scaled"])
design_notes = "Soul Thread no longer owns stun or stance damage. Its projectile is delivery only. On contact it creates one SoulThreadLink between Grace and the target. The link exposes soul_threaded metadata/group state for future Soul follow-ups, applies a soft physics/velocity leash beyond its slack radius, refreshes instead of stacking, and breaks cleanly on expiry, invalid actors, or excessive range."
ability_scene = ExtResource("1_scene")
action_payload = ExtResource("2_payload")
