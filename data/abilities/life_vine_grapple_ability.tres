script = ExtResource("2_definition")
display_name = "Vine Grapple"
description = "Launch a living Life vine at an enemy or movable object and reel the target toward Grace while Cast is held. Unlike Metal Tether, the vine moves the world instead of moving Grace."
element = "life"
category = 4
