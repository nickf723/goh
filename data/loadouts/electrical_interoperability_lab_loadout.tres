[gd_resource type="Resource" script_class="AbilityLoadout" format=3]

[ext_resource type="Script" path="res://scripts/abilities/ability_definition.gd" id="1_definition"]
[ext_resource type="Script" path="res://scripts/abilities/ability_loadout.gd" id="2_loadout"]
[ext_resource type="Resource" path="res://data/abilities/lightning_spark_ability.tres" id="3_lightning"]
[ext_resource type="Resource" path="res://data/abilities/firebolt_ability.tres" id="4_fire"]

[resource]
script = ExtResource("2_loadout")
quick_slot_count = 2
learned_abilities = Array[ExtResource("1_definition")]([ExtResource("3_lightning"), ExtResource("4_fire")])
equipped_abilities = Array[ExtResource("1_definition")]([ExtResource("3_lightning"), ExtResource("4_fire")])
