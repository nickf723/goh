[resource]
script = ExtResource("2_definition")
display_name = "Repeat"
description = "Reserve 30 percent of Grace's maximum mana to summon a time-lagged echo one second behind her. It repeats movement, weapon attacks, and clone-safe spells as fresh actions against the later world. Cast Repeat again to release it."
element = "time"
category = 4
mana_cost = 0
use_trait_profile = false
spell_id = "repeat"
short_label = "Repeat"
icon_text = "R↺"
roles = Array[String](["concentration", "time", "echo", "ally", "delayed_copy", "damage_support", "spell_replay", "persistent"])
targeting_style = "self_centered"
delivery_type = "delayed_echo_concentration"
combo_tags = Array[String](["time", "repeat", "echo", "delayed", "copy", "ally", "clone_synergy", "spell_echo"])
status_tags = Array[String]([])
ui_tags = Array[String](["concentration", "30% reserve", "1s delay", "weapon echo", "spell echo"])
debug_tags = Array[String](["timeline_history", "pose_replay", "weapon_replay", "spell_replay", "fresh_world_interaction", "multi_echo_ready", "multi_source_hook"])
scaling_stats = Array[String](["focus", "time", "skill"])
scaling_note = "Future upgrades can reduce mana reservation, tune delay, increase repeated attack power, and add additional echoes."
design_notes = "Repeat records Grace's transform and articulated pose, then replays that timeline one second later. Clone-safe spells are re-instantiated from the historical echo position with original cast intent but no copied target list or prior outcome. The shared clone policy is reusable by future Soul duplicates."
ability_scene = ExtResource("1_scene")
