theme_override_font_sizes/font_size = 18
text = "WASD / Left Stick     Move\nMouse / Right Stick   Camera\nSpace / Y              Jump\nC / A                  Dodge\nE / B                  Interact\nLeft Click / X         Light attack\nQ / Right Trigger      Cast selected spell\nMiddle Mouse / L3      Hold Focus spell menu\n1–0 / D-pad            Select spells\nTab or M               Open full menu\nEsc                    Close this panel"
horizontal_alignment = 1

[node name="Note" type="Label" parent="ControlsPanel/Center/Panel/Content"]
