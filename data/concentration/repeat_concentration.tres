[ext_resource type="Script" path="res://scripts/concentration/concentration_effect_definition.gd" id="1_concentration"]

[resource]
script = ExtResource("1_concentration")
effect_id = "repeat_concentration"
display_name = "Repeat"
description = "Reserve 30 percent of Grace's mana capacity to sustain a time-lagged echo. The echo replays Grace's movement and articulated pose one second later and repeats her weapon attacks at reduced power."
mana_reservation_fraction = 0.30
free_elements = Array[String]([])
discounted_elements = {}
effect_tags = Array[String](["concentration", "time", "repeat", "echo", "ally", "delayed_copy"])
