scaling_stats = Array[String](["arcana", "life", "skill"])
scaling_note = "Life and Arcana can expand network growth and duration; Skill is reserved for denser branching and more authored environmental responses."
design_notes = "Matrix contract: Burst / Spatial / Field State. The matrix currently spells the name 'Mycellium Mesh'; the canonical game-facing spelling is Mycelium Mesh. This spell owns growth and network influence, not direct damage. Nearby authored systems can react through receive_mycelium_growth or receive_mycelium_field, allowing future Fire, Poison, vegetation, decomposition, and ecology interactions without hard-coding them into the spell."
