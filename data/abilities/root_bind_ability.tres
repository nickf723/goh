[resource]
script = ExtResource("2_definition")
display_name = "Root Bind"
description = "Aim at an enemy or movable object and command roots to seize it. Enemies remain able to act but cannot translate; physics objects are pinned until the roots release."
element = "life"
category = 4
mana_cost = 2
stamina_cost = 0
focus_cost = 0
use_trait_profile = false
spell_id = "root_bind"
short_label = "Roots"
icon_text = "RB"
roles = Array[String](["control", "root", "bind", "anchor", "utility", "object_interaction", "enemy_control"])
targeting_style = "aimed_target"
delivery_type = "target_binding"
combo_tags = Array[String](["life", "roots", "plant", "bind", "anchor", "immobilize", "utility", "aimed"])
status_tags = Array[String](["rooted"])
ui_tags = Array[String](["control", "utility", "enemy_or_object", "aimed"])
debug_tags = Array[String](["rooted_status", "rigid_body_pin", "action_preserving_control", "bounds_driven_roots", "narrow_aim_assist"])
scaling_stats = Array[String](["life", "arcana", "skill"])
scaling_note = "Life can extend root duration; Arcana can increase the mass ceiling; Skill can widen acquisition without turning Root Bind into a stun."
design_notes = "Root Bind uses hard lock, exact camera-center targeting, then a narrow aim-assist cone for enemies and physics objects. The visible roots measure target collision bounds so bands and climbing roots remain outside crates and other solid props. Rooted enemies keep their actions but lose translation; RigidBody objects are frozen at rest and restored when the binding expires."
