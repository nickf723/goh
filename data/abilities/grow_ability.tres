debug_tags = Array[String](["collision_resize", "clearance_checked", "persistent_form", "dynamic_mass"])
scaling_stats = Array[String](["power", "body", "focus"])
scaling_note = "Power and Body govern physical amplification; Focus is reserved for future maximum scale, clearance control, and duration-efficient variants."
design_notes = "Grow is an indefinite mutually exclusive body form. The same spell toggles back to normal without a second Mana payment. Expansion is rejected and refunded when the larger collision capsule cannot fit."
