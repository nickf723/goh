[resource]
script = ExtResource("2_definition")
display_name = "Grow"
description = "Increase Grace's physical size and mass. Grow strengthens weapon damage, stance pressure, reach, and resistance, but makes movement and attacks slower. Cast Grow again to return to normal size for free."
element = "body"
category = 3
mana_cost = 3
use_trait_profile = false
