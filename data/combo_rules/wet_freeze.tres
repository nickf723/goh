[gd_resource type="Resource" script_class="ComboRule" format=3]

[ext_resource type="Script" path="res://scripts/systems/combo_rule.gd" id="1_combo_rule"]

[resource]
script = ExtResource("1_combo_rule")
rule_id = "ice_x_wet"
display_name = "Wet Freeze"
description = "Ice freezes wet targets solid."
incoming_tags = Array[String](["ice"])
target_tags = Array[String](["wet"])
priority = 80
reaction_id = "wet_freeze"
reaction_name = "Freeze"
feedback_text = "{target} freezes solid."
visual_style = "freeze"
visual_color = Color(0.56, 0.94, 1, 1)
visual_radius = 1.45
visual_duration = 0.5
target_reaction_method = "trigger_freeze"
output_status = "frozen"
output_status_duration = 10.0
output_status_strength = 1.0
output_status_source = "wet_freeze"
output_tags = Array[String](["ice", "wet", "frozen", "reaction"])
debug_tags = Array[String](["elemental", "status_combo", "ice"])
design_notes = "Water sets up hard ice control. Wet enemies and water surfaces now share the same Freeze feedback and state."
