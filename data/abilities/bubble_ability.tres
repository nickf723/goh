scaling_note = "Arcana and Water govern the ward; Focus is reserved for future duration, radius, and multi-hit upgrade branches."
design_notes = "Bubble is a one-hit defensive conversion spell. Dodged and element-immune attacks do not consume it. The first attack that reaches ordinary defense resolution loses all health and stance damage, applies no hit reaction, and triggers one bounded outward-force query. Recasting refreshes the same controller instead of stacking shields."
