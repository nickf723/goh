[gd_resource type="Resource" script_class="AbilityDefinition" format=3]

[ext_resource type="PackedScene" path="res://scenes/actions/firewall_cast.tscn" id="1_scene"]
[ext_resource type="Script" path="res://scripts/abilities/ability_definition.gd" id="2_definition"]
[ext_resource type="Resource" path="res://data/damage_payloads/firewall_payload.tres" id="3_payload"]

[resource]
script = ExtResource("2_definition")
display_name = "Firewall"
description = "Hold Cast to laser-etch a path across floors, walls, and ceilings. Releasing Cast, reaching the path limit, or exhausting the draw timer erupts the traced line into lingering flame."
element = "fire"
category = 4
mana_cost = 4
use_trait_profile = false
spell_id = "firewall"
short_label = "Firewall"
icon_text = "╫╫"
roles = Array[String](["damage", "burn", "hazard", "area_control", "surface_drawing", "puzzle", "combo_starter"])
targeting_style = "aimed_surface_channel"
delivery_type = "channel_then_field"
combo_tags = Array[String](["fire", "firewall", "surface_path", "lingering", "wall", "heat", "terrain"])
status_tags = Array[String](["burning"])
ui_tags = Array[String](["hold_cast", "draw_path", "release_to_ignite", "surface_transition"])
debug_tags = Array[String](["prototype", "single_node_lifecycle", "multimesh", "no_per_segment_nodes", "corner_bridge"])
scaling_stats = Array[String](["arcana", "fire", "focus"])
scaling_note = "Fire and Arcana govern heat and damage; Focus is reserved for future draw time, path length, and corner stability upgrades."
design_notes = "Firewall uses an authored surface-normal path rather than a flat ground spline. Each segment erupts away from the surface it was painted on, so floor lines rise, wall lines project outward, and ceiling lines burn downward. Sharp surface changes insert projected corner points and blended-normal plume joints to keep the result continuous around architectural edges."
action_payload = ExtResource("3_payload")
ability_scene = ExtResource("1_scene")
metadata/_custom_type_script = "res://scripts/abilities/ability_definition.gd"
